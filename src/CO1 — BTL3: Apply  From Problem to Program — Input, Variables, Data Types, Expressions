import java.util.Scanner;

public class CO1_UniversityTracker {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("======================================");
        System.out.println(" UNIVERSITY GRADE & ATTENDANCE TRACKER");
        System.out.println("======================================");

        // Primitive data types
        int rollNo;
        int semester;

        double marks1;
        double marks2;
        double marks3;
        double marks4;
        double marks5;

        String name;
        String department;

        // Sequential input
        System.out.print("Enter student name: ");
        name = sc.nextLine();

        System.out.print("Enter roll number: ");
        rollNo = sc.nextInt();

        sc.nextLine();

        System.out.print("Enter department: ");
        department = sc.nextLine();

        System.out.print("Enter semester: ");
        semester = sc.nextInt();

        System.out.println("\nEnter marks for five subjects");

        System.out.print("Java: ");
        marks1 = sc.nextDouble();

        System.out.print("Digital Logic: ");
        marks2 = sc.nextDouble();

        System.out.print("Mathematics: ");
        marks3 = sc.nextDouble();

        System.out.print("English: ");
        marks4 = sc.nextDouble();

        System.out.print("Computer Architecture: ");
        marks5 = sc.nextDouble();

        // Expressions
        double totalMarks =
                marks1 + marks2 + marks3 + marks4 + marks5;

        double averageMarks =
                totalMarks / 5;

        // Output
        System.out.println("\n========== STUDENT DETAILS ==========");

        System.out.println("Name       : " + name);
        System.out.println("Roll No    : " + rollNo);
        System.out.println("Department : " + department);
        System.out.println("Semester   : " + semester);

        System.out.println("\n========== MARKS ==========");

        System.out.println("Java                 : " + marks1);
        System.out.println("Digital Logic        : " + marks2);
        System.out.println("Mathematics          : " + marks3);
        System.out.println("English              : " + marks4);
        System.out.println("Computer Architecture: " + marks5);

        System.out.println("\nTotal Marks   : " + totalMarks);
        System.out.println("Average Marks : " + averageMarks);

        sc.close();
    }
}
